# Local development environment for docker-compose.
#
# Copy this file to `.env` to override any of these values — docker-compose
# loads `.env` from the project root automatically, no extra flags needed.
# Every value below already matches the built-in default in
# docker-compose.yml, so `docker-compose up --build` works with zero setup
# even without a `.env` file at all; this file exists so you can change one
# value (e.g. a port that's already in use) without editing
# docker-compose.yml itself.
#
# For a production-like run with real secrets, see .env.production.example
# instead — don't reuse these dev-only credentials anywhere but your machine.

# --- PostgreSQL ---
POSTGRES_DB=angora
POSTGRES_USER=angora
POSTGRES_PASSWORD=angora
POSTGRES_PORT=5432

# --- Ports published to the host ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
