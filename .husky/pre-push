# Soft guardrail only — NOT a substitute for real branch protection.
#
# GitHub's branch protection / rulesets are unavailable on this repo right
# now: it's private on a plan that gates that feature behind "upgrade to
# GitHub Pro or make this repository public" (confirmed via the API — see
# AGENTS.md). This hook blocks `git push` directly to `main` from a machine
# that has this repo's hooks installed, forcing changes through a branch +
# PR instead.
#
# It does NOT stop: pushes from a clone without `pnpm install` run (which
# is what wires up husky), `git push --no-verify`, or anyone pushing via
# the GitHub web UI/API directly. PR merges themselves are unaffected —
# merging via the GitHub UI or `gh pr merge` doesn't go through this hook.
#
# Remove this file once the repo goes public or the org is on a plan that
# supports real branch protection, and set that up instead.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct push to main is blocked on this machine. Push a branch and open a PR instead." >&2
    exit 1
  fi
done
